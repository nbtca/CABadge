	(text "GEK100_13 / SOT-23-6 / hardware 1s ON, 3s OFF"
		(at 30.48 30.48 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "ebf0ae93-0b6d-4734-88d3-c8d974301189")
	)
	(text "VDD from always-present VSYS; OUTH drives PWR_EN, not load current.\nRST tied low: no firmware change required. OUTL intentionally unconnected.\nR28 pull-down and R39 charging interlock retained on sheet 4.\nDefault OFF; charging path retained while system is OFF.\nSW1 reuses the existing side-actuated BOOT/RESET switch footprint.\nUSB/battery handover and startup/reset behavior require bench validation."
		(at 30.48 167.64 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "9ae2f3ba-bb2d-48ed-a072-928232fecbff")
	)
